# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าจริง — ห้าม commit .env ตัวจริง (อยู่ใน .gitignore แล้ว)

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sme_inventory
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# NFR-PRIV-01 — จำนวนปีที่เก็บข้อมูลผู้ซื้อก่อน purge (ดู CR-001)
DATA_RETENTION_YEARS=3

# FR-012 / CR-006 — แจ้งเตือนสต็อกใกล้หมดผ่านอีเมล
# ว่างไว้ = dev-mode (log แทนส่งจริง) — ต้องหา SMTP provider เอง (Gmail app password,
# Resend, SendGrid free tier ฯลฯ) ทีมต้องตั้งค่าเอง ไม่มีใครควรใส่ credential จริงในไฟล์นี้
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
